---
import { copy, type Lang, text } from '../lib/copy';
import Icon from './Icon.astro';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
---

<section class="film-section container" id="film">
  <div class="section-heading">
    <h2>{t.filmTitle}</h2>
    <p>{t.filmBody}</p>
  </div>
  <div class="film-shell">
    <video
      id="product-film"
      controls
      playsinline
      preload="none"
      poster="/images/deck-detail.webp"
      aria-label={text(lang, 'Herdeck product film', 'Produktový film Herdeck')}
    >
      <source src={`/film/herdeck-${lang}.mp4`} type="video/mp4" />
      <track
        kind="captions"
        src={`/film/${lang}.vtt`}
        srclang={lang}
        label={lang === 'cs' ? 'Čeština' : 'English'}
        default
      />
      <a href={`/film/herdeck-${lang}.mp4`}>{t.watch}</a>
    </video>
    <button class="film-play" aria-label={t.filmPlay} hidden>
      <span class="play-circle">
        <Icon name="play" size={32} />
      </span>
      <span>
        {t.watch}
        <small>00:30 · {text(lang, 'Sound on', 'Se zvukem')}</small>
      </span>
    </button>
  </div>
  <div class="film-caption">
    <span>{t.filmSound}</span>
    <a href={`/film/herdeck-${lang}.mp4`} download>
      {text(lang, 'Download film', 'Stáhnout film')}
      <Icon name="download" size={14} />
    </a>
  </div>
  <details class="film-transcript">
    <summary>{text(lang, 'Read the film transcript', 'Přečíst obsah filmu')}</summary>
    <p>
      {text(
        lang,
        'Your agents. At your fingertips. Claude is waiting. Codex is building. One fleet. One view. Read the request. Make the call. Back in flow. On your deck. On your desktop. Across your machines. Herdeck. Your agents, under your control.',
        'Tvoji agenti. Na dosah ruky. Claude čeká. Codex pracuje. Jedna flotila. Jeden přehled. Přečti požadavek. Rozhodni. A pokračuj. Na decku. Na desktopu. Napříč stroji. Herdeck. Tvoji agenti pod tvou kontrolou.',
      )}
    </p>
  </details>
</section>
<script>
  const video = document.querySelector<HTMLVideoElement>('#product-film');
  const play = document.querySelector<HTMLButtonElement>('.film-play');
  // Native controls remain reachable when JavaScript is unavailable.
  if (play) play.hidden = false;
  const start = () => {
    if (!video) return;
    video.muted = false;
    video.play().catch(() => {
      if (play) play.hidden = false;
    });
  };
  play?.addEventListener('click', start);
  video?.addEventListener('play', () => {
    if (play) play.hidden = true;
  });
  video?.addEventListener('ended', () => {
    if (play) play.hidden = false;
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-watch]').forEach((link) =>
    link.addEventListener('click', () => {
      start();
    }),
  );
</script>
