---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { type Lang, text } from '../lib/copy';
const { lang } = Astro.props as { lang: Lang };
// The deck is captured from Herdeck's real renderer and press logic
// (scripts/capture-deck.py). The first view is rendered here so the deck is
// complete before, and without, JavaScript.
type Tile = string | string[];
// views[i].t: 13 key images + the status window, as indexes into `tiles`;
// views[i].a: the matching screen-reader labels, as indexes into `labels`.
type Graph = {
  start: Record<string, number>;
  tiles: Tile[];
  labels: string[];
  views: { t: number[]; a: number[] }[];
};
// Read from the project root: in a build this module runs from a bundled chunk.
const graph = JSON.parse(
  readFileSync(join(process.cwd(), 'public', 'deck', lang, 'graph.json'), 'utf8'),
) as Graph;
const view = graph.views[graph.start['needs-you']];
const first = view.t.map((t) => graph.tiles[t]);
const label = (i: number) => graph.labels[view.a[i]];
const src = (tile: Tile) => `/deck/${lang}/${Array.isArray(tile) ? tile[0] : tile}.webp`;
const scenarios = [
  ['needs-you', text(lang, 'Needs you', 'Čeká na tebe')],
  ['big-fleet', text(lang, 'Big fleet', 'Velká flotila')],
  ['outage', text(lang, 'Machine down', 'Výpadek stroje')],
  ['offline', text(lang, 'All offline', 'Vše offline')],
];
---

<herdeck-demo data-lang={lang}>
  <div
    class="deck"
    role="group"
    aria-label={text(lang, 'Simulated Herdeck deck', 'Simulovaný deck Herdecku')}
  >
    <div class="deck-grid">
      {first.slice(0, 13).map((tile, index) => (
        <button class="deck-key" data-key={index} aria-label={label(index)}>
          <img src={src(tile)} alt="" width="196" height="196" />
        </button>
      ))}
      <button class="deck-panel" data-key="13" aria-label={label(13)}>
        <img src={src(first[13])} alt="" width="458" height="196" />
      </button>
    </div>
  </div>
  <div class="deck-controls">
    <div class="deck-scenarios" role="group" aria-label={text(lang, 'Scenario', 'Scénář')}>
      {scenarios.map(([id, label]) => (
        <button data-scenario={id} aria-pressed={id === 'needs-you' ? 'true' : 'false'}>
          {label}
        </button>
      ))}
    </div>
    <p class="deck-note">
      {text(
        lang,
        'Herdeck’s real renderer and key logic, replaying an invented fleet. Press any key or the status window.',
        'Skutečný renderer a logika kláves Herdecku nad smyšlenou flotilou. Zkus libovolnou klávesu nebo stavové okno.',
      )}
    </p>
  </div>
  <p class="sr-only" aria-live="polite" data-announce></p>
  <noscript>
    <p class="deck-note">
      {text(
        lang,
        'Enable JavaScript to press the keys. The demo runs entirely in your browser, with no connection to real agents.',
        'Pro mačkání kláves zapni JavaScript. Ukázka běží jen v prohlížeči, bez připojení ke skutečným agentům.',
      )}
    </p>
  </noscript>
</herdeck-demo>
<script>
  type Tile = string | string[];
  type View = { t: number[]; a: number[]; e: Record<string, number>; to?: [number, number] };
  type Graph = { start: Record<string, number>; tiles: Tile[]; labels: string[]; views: View[] };

  const FRAME_MS = 400; // the runtime tick that advances the working animation

  class HerdeckDemo extends HTMLElement {
    private graph?: Graph;
    private current = 0;
    private phase = 0;
    private timer?: number;
    private animation?: number;
    private token = 0;
    private keys: HTMLButtonElement[] = [];
    private images: HTMLImageElement[] = [];

    async connectedCallback() {
      this.keys = [...this.querySelectorAll<HTMLButtonElement>('[data-key]')];
      this.images = this.keys.map((key) => key.querySelector('img')!);
      const response = await fetch(`/deck/${this.dataset.lang}/graph.json`);
      if (!response.ok) return;
      this.graph = (await response.json()) as Graph;
      this.current = this.graph.start['needs-you'];
      this.keys.forEach((key) =>
        key.addEventListener('click', () => this.press(Number(key.dataset.key))),
      );
      this.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach((button) =>
        button.addEventListener('click', () => {
          this.querySelectorAll('[data-scenario]').forEach((other) =>
            other.setAttribute('aria-pressed', String(other === button)),
          );
          this.show(this.graph!.start[button.dataset.scenario!], true);
        }),
      );
      this.show(this.current, false);
      this.dataset.ready = '';
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        this.animation = window.setInterval(() => {
          this.phase = (this.phase + 1) % 8;
          this.paint(this.view(), false);
        }, FRAME_MS);
      }
    }

    disconnectedCallback() {
      clearTimeout(this.timer);
      clearInterval(this.animation);
    }

    private view() {
      return this.graph!.views[this.current];
    }

    private url(tile: Tile) {
      const name = Array.isArray(tile) ? tile[this.phase % tile.length] : tile;
      return `/deck/${this.dataset.lang}/${name}.webp`;
    }

    private press(key: number) {
      const next = this.view().e[String(key)];
      if (next !== undefined) this.show(next, true);
    }

    // Swap a whole view at once, after its images are decoded, so a press never
    // shows half old and half new keys.
    private async show(index: number, announce: boolean) {
      const token = ++this.token;
      clearTimeout(this.timer);
      const view = this.graph!.views[index];
      const urls = view.t.map((t) => this.url(this.graph!.tiles[t]));
      await Promise.race([
        Promise.all(
          urls.map((u) => {
            const img = new Image();
            img.src = u;
            return img.decode().catch(() => undefined);
          }),
        ),
        new Promise((resolve) => setTimeout(resolve, 400)),
      ]);
      if (token !== this.token) return;
      const previous = this.view();
      this.current = index;
      this.dataset.view = String(index);
      this.paint(view, true);
      if (announce && previous.a[13] !== view.a[13]) {
        this.querySelector('[data-announce]')!.textContent = this.graph!.labels[view.a[13]];
      }
      if (view.to) {
        const [ms, target] = view.to;
        this.timer = window.setTimeout(() => this.show(target, true), ms);
      }
      this.prefetch(view);
    }

    private paint(view: View, labels: boolean) {
      view.t.forEach((t, i) => {
        const url = this.url(this.graph!.tiles[t]);
        if (!this.images[i].src.endsWith(url)) this.images[i].src = url;
        if (labels) this.keys[i].setAttribute('aria-label', this.graph!.labels[view.a[i]]);
      });
    }

    // Warm the cache with every view one press away.
    private prefetch(view: View) {
      const next = new Set(Object.values(view.e));
      if (view.to) next.add(view.to[1]);
      next.forEach((index) => {
        const target = this.graph!.views[index];
        target.t.forEach((t) => {
          const tile = this.graph!.tiles[t];
          const img = new Image();
          img.src = `/deck/${this.dataset.lang}/${Array.isArray(tile) ? tile[0] : tile}.webp`;
        });
      });
    }
  }
  customElements.define('herdeck-demo', HerdeckDemo);
</script>
