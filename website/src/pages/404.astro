---
import Layout from '../layouts/Layout.astro';
---

<Layout lang="en" title="Page not found">
  <section class="page-intro container">
    <p class="breadcrumb">404</p>
    <h1>This page is off the grid.</h1>
    <p>Stránku jsme nenašli. / We could not find that page.</p>
    <div class="button-row" style="margin-top:30px">
      <a class="button" href="/en/">
        English home
      </a>
      <a class="button button-quiet" href="/cs/">
        Česká úvodní stránka
      </a>
    </div>
  </section>
</Layout>
