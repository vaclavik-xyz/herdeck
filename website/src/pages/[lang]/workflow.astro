---
import Layout from '../../layouts/Layout.astro';
import DeckDemo from '../../components/DeckDemo.astro';
import CTA from '../../components/CTA.astro';
import { languages, local, text, path, type Lang } from '../../lib/copy';
export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const steps = [
  {
    title: ['Start with your agents', 'Začni u svých agentů'],
    body: [
      'Run your coding agents in Herdr. Open Herdeck and choose the local sessions you want to see. Add remote bridges if your work lives on another machine.',
      'Spusť coding agenty v Herdr. Otevři Herdeck a vyber lokální sessions, které chceš sledovat. Pokud pracuješ na jiném stroji, přidej vzdálený bridge.',
    ],
    note: ['Connect once. Keep working.', 'Připoj jednou. Pokračuj v práci.'],
  },
  {
    title: ['Let the fleet get to work', 'Nech flotilu pracovat'],
    body: [
      'Agent tiles show the project and live state. Working is green, done is cyan, and a request for your input turns amber. You do not need to keep checking every terminal.',
      'Dlaždice ukazují projekt a aktuální stav. Zelená znamená práci, azurová hotovo a oranžová čekání na tvou odpověď. Nemusíš pořád kontrolovat každý terminál.',
    ],
    note: ['A glance gives you the picture.', 'Jeden pohled a máš přehled.'],
  },
  {
    title: ['Make the next decision', 'Rozhodni, co dál'],
    body: [
      'Press the status panel to open the agent that has waited longest. Read the prompt, then approve, deny, or stop. Open the terminal when the situation needs more context.',
      'Stiskni stavový panel a otevři agenta, který čeká nejdéle. Přečti si požadavek, pak ho schval, zamítni nebo zastav. Když potřebuješ více kontextu, otevři terminál.',
    ],
    note: ['Context before action.', 'Nejdřív kontext, potom akce.'],
  },
  {
    title: ['Get back to your flow', 'Vrať se ke své práci'],
    body: [
      'After your answer, Herdeck moves to the next waiting agent. When the queue is clear, the overview returns. Your attention goes back to what you were making.',
      'Po odpovědi Herdeck přejde k dalšímu čekajícímu agentovi. Když je fronta prázdná, vrátí se přehled. Ty se můžeš věnovat tomu, co tvoříš.',
    ],
    note: ['All clear. Carry on.', 'Vše vyřízeno. Pokračuj.'],
  },
];
---

<Layout lang={lang} page="workflow" title="Workflow">
  <section class="page-intro container">
    <p class="breadcrumb">Herdeck / Workflow</p>
    <h1>
      {text(lang, 'Stay in the flow.\nStay in control.', 'Udrž si tempo.\nUdrž si kontrolu.')}
    </h1>
    <p>
      {text(
        lang,
        'A small loop that makes a busy desk feel manageable. Connect, glance, decide, continue.',
        'Krátký postup, který vnese přehled i do nabitého dne. Připoj se, zkontroluj stav, rozhodni a pokračuj.',
      )}
    </p>
  </section>
  <section class="workflow-steps container">
    {steps.map((s, i) => (
      <article>
        <div class="step-number">{String(i + 1).padStart(2, '0')}</div>
        <div>
          <h2>{local(lang, s.title)}</h2>
          <p>{local(lang, s.body)}</p>
        </div>
        <span>{local(lang, s.note)}</span>
      </article>
    ))}
  </section>
  <section class="workflow-demo container">
    <div class="section-heading">
      <h2>{text(lang, 'Try the decision loop.', 'Vyzkoušej si to.')}</h2>
      <p>
        {text(
          lang,
          'This is a safe, simulated example. Nothing is sent to a real agent.',
          'Toto je bezpečná simulace. Skutečným agentům se nic neodesílá.',
        )}
      </p>
    </div>
    <DeckDemo lang={lang} />
    <a class="text-link" href={path(lang, 'docs/controls')}>
      {text(lang, 'Read the controls guide', 'Přečíst průvodce ovládáním')}
    </a>
  </section>
  <CTA lang={lang} />
</Layout>
