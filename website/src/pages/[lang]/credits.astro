---
import Layout from '../../layouts/Layout.astro';
import { languages, type Lang, text, repository } from '../../lib/copy';
export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---

<Layout lang={lang} page="credits" title={text(lang, 'Visuals & credits', 'Vizuály a licence')}>
  <section class="page-intro container">
    <p class="breadcrumb">Herdeck / {text(lang, 'Credits', 'Licence')}</p>
    <h1>
      {text(lang, 'Made with care.\nShared in the open.', 'S péčí o detail.\nS otevřeným kódem.')}
    </h1>
  </section>
  <article class="prose credits-prose container">
    <h2>{text(lang, 'Herdeck', 'Herdeck')}</h2>
    <p>
      {text(
        lang,
        'Herdeck and the website source code are released under the MIT License. Copyright © 2026 Filip Vaclavik.',
        'Herdeck a zdrojový kód webu jsou vydané pod licencí MIT. Copyright © 2026 Filip Vaclavik.',
      )}{' '}
      <a href={`${repository}/blob/main/LICENSE`}>MIT License</a>.
    </p>
    <h2>{text(lang, 'D200 product images', 'Produktové snímky D200')}</h2>
    <p>
      {text(
        lang,
        'The product images come from Ulanzi and show the real D200 model with stock Ulanzi software. They do not show Herdeck running on the device. The interactive deck uses simulated agents. Images remain the property of Ulanzi and are not covered by the source code MIT license.',
        'Produktové snímky pocházejí od Ulanzi a ukazují skutečný model D200 s původním softwarem Ulanzi. Nezachycují spuštěný Herdeck. Interaktivní deck používá simulované agenty. Snímky zůstávají majetkem Ulanzi a nevztahuje se na ně licence MIT zdrojového kódu.',
      )}
    </p>
    <p>
      <a href="https://www.ulanzi.com/cdn/shop/files/14_14_11zon_381246ba-6f9d-4199-a711-d5c63a6ecb9c.webp?v=1726212953">
        {text(lang, 'Original D200 image', 'Originální snímek D200')}
      </a>
      ·{' '}
      <a href="https://www.ulanzi.com/cdn/shop/files/8_8_11zon_8c923c8c-cc9c-4bd5-b66d-d07d2156f287.webp?v=1726212953">
        {text(lang, 'Original desk photograph', 'Originální fotografie na stole')}
      </a>
    </p>
    <h2>{text(lang, 'Film & original music', 'Film a původní hudba')}</h2>
    <p>
      {text(
        lang,
        'The 30-second film is built in Remotion, with Czech and English editions. The original 128 BPM electronic score is synthesized from source: drums, bass, arpeggios, transitions, and a final master. It contains no third-party samples or recordings. Film and score source are included in the repository.',
        'Třicetisekundový film vznikl v Remotionu v české i anglické verzi. Původní elektronická hudba o tempu 128 BPM je syntetizovaná ze zdrojového kódu: bicí, basy, arpeggia, přechody a finální mastering. Neobsahuje cizí samply ani nahrávky. Zdroj filmu i hudby je součástí repozitáře.',
      )}
    </p>
    <h2>{text(lang, 'Type & agent marks', 'Písma a značky agentů')}</h2>
    <p>
      {text(
        lang,
        'Sora and Manrope are self-hosted through Fontsource under the SIL Open Font License. Agent icons reuse the attributed assets already included with Herdeck. Brand marks remain trademarks of their owners; their appearance identifies integrations and does not imply endorsement.',
        'Sora a Manrope jsou hostované přímo na webu přes Fontsource pod licencí SIL Open Font License. Ikony agentů používají podklady se zdroji uvedenými v Herdecku. Značky zůstávají ochrannými známkami svých vlastníků; jejich zobrazení označuje integrace a neznamená doporučení produktu.',
      )}{' '}
      <a href={`${repository}/blob/main/src/herdeck/assets/ATTRIBUTION.md`}>
        {text(lang, 'Agent icon attribution', 'Zdroje ikon agentů')}
      </a>
      .
    </p>
    <h2>{text(lang, 'Privacy', 'Soukromí')}</h2>
    <p>
      {text(
        lang,
        'This static website does not set analytics cookies, load remote fonts, or connect to your agents. The demo runs entirely in your browser. Video and audio are served from this website and start only when you press play.',
        'Tento statický web neukládá analytické cookies, nenačítá vzdálená písma a nepřipojuje se k tvým agentům. Ukázka běží jen v prohlížeči. Video i zvuk jsou uložené přímo na webu a spustí se až po stisku přehrávání.',
      )}
    </p>
  </article>
</Layout>
